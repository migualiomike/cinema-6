[ext_resource type="Texture2D" uid="uid://u7c850tkdvoj" path="res://scenes/props/glowing_numbers/UE4_1m x 1m.png" id="1_bqunb"]

[sub_resource type="GDScript" id="GDScript_bqunb"]
resource_name = "GlowingNumberScript"
script/source = "extends Node3D

@export var meshes: Array[MeshInstance3D]
var current_mesh : MeshInstance3D

var mesh_dict = {}

func _ready() -> void:
	for mesh_instance in meshes:
		mesh_dict[mesh_instance.name] = mesh_instance
		mesh_instance.hide() # Start with all hidden

func show_mesh_by_number(target_number: int) -> void:
	if current_mesh:
		current_mesh.hide()
	# Show the new one
	current_mesh = mesh_dict.get(str(target_number))
	if current_mesh:
		current_mesh.show()
"

