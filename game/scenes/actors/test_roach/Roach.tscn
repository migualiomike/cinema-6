[sub_resource type="GDScript" id="GDScript_yecqj"]
resource_name = "RoachBrain"
script/source = "extends CSM
#@onready var animation_player: AnimationPlayer = $\"../AnimationPlayer\"

@export var animation_player : AnimationPlayer

@export var walk_speed := 2.0
@export var run_speed := 4.0

@export var min_idle_time := 1.0
@export var max_idle_time := 3.0
@export var min_hide_time := 1.0
@export var max_hide_time := 5.0
@export var safe_distance: float = 5.0
@export var movement_target_position: Vector3 = Vector3(-3.0, 0.0, 2.0)

@export var idle_ani := \"\"
@export var walk_ani := \"\"
var escape_angle_variance: float = PI / 4

var bored_timer: float = 0.0
var _is_player_too_close: bool = false
var current_speed := 2.0

@export var navigation_agent: NavigationAgent3D
@export var detect_player_area: Area3D

var close_players : Array[Node3D] = []
var escape_hole : Node3D


func _ready() -> void:
	super._ready()
	_connect_signals()
	escape_hole = master.escape_hole





#region Destination Selection
func pick_random_destination() -> void:
	var random_offset := Vector3(
		randf_range(-5.0, 5.0),
		0,
		randf_range(-5.0, 5.0)
	)
	movement_target_position = master.global_position + random_offset
	navigation_agent.set_target_position(movement_target_position)
	#print(\"New random destination: \", random_offset)

func pick_escape_destination() -> void:
	if not is_player_too_close():
		return
	var closest_player := get_closest_player()
	if debug: print(\"Choosing escape destination\")
	var direction_away_from_player: Vector3 = (master.global_position - closest_player.global_position).normalized()
	direction_away_from_player = _add_randomness_to_direction(direction_away_from_player)
	
	var escape_distance: float = randf_range(safe_distance, safe_distance * 1.5)
	var potential_target: Vector3 = master.global_position + direction_away_from_player * escape_distance
	
	navigation_agent.set_target_position(potential_target)

func _add_randomness_to_direction(direction: Vector3) -> Vector3:
	return direction.rotated(
		Vector3.UP,
		randf_range(-escape_angle_variance, escape_angle_variance)
	)
#endregion

#region Movement
func try_move_to_target(delta: float) -> void:
	if get_current_state_name() == \"Hide\":
		return
		
	if not navigation_agent.is_navigation_finished():
		move_to_target(delta)
#
func move_to_target(delta: float) -> void:
	var next_path_pos: Vector3 = navigation_agent.get_next_path_position()
	var direction: Vector3 = (next_path_pos - master.global_position).normalized()
	
	master.velocity = direction * current_speed
	
	rotate_toward_direction(direction, delta)
	master.move_and_slide()
#
func rotate_toward_direction(direction: Vector3, delta: float) -> void:
	if direction.length() > 0.1:
		var target_rotation: float = atan2(direction.x, direction.z)
		master.rotation.y = lerp_angle(master.rotation.y, target_rotation, 10 * delta)
	
func set_speed(speed: float) -> void:
	current_speed = speed
#endregion

#region Player Detection
func is_player_too_close() -> bool:
	if close_players.is_empty():
		return false
	else: return true

func get_closest_player() -> Node3D:
	if close_players.is_empty(): push_error(\"No players nearby\")
	var closest_player: Node3D = null
	var shortest_distance_squared: float = INF 
	
	for player in close_players:
		var distance_squared : float = master.global_position.distance_squared_to(player.global_position)
		if distance_squared < shortest_distance_squared:
			shortest_distance_squared = distance_squared
			closest_player = player

	return closest_player


func _connect_signals() -> void:
	detect_player_area.body_entered.connect(_on_detect_player_area_body_entered)
	detect_player_area.body_exited.connect(_on_detect_player_area_body_exited)

func _on_detect_player_area_body_entered(body: Node3D) -> void:
	if _is_player(body):
		close_players.append(body)

func _on_detect_player_area_body_exited(body: Node3D) -> void:
	if _is_player(body):
		close_players.erase(body)

func _is_player(body: Node3D) -> bool:
	return body is CharacterBody3D and body.is_in_group(\"Player\")
#endregion


#region Utility
func reset_bored_timer() -> void:
	bored_timer = randf_range(min_idle_time, max_idle_time)
#endregion
"

[sub_resource type="GDScript" id="GDScript_04idm"]
resource_name = "RoachIdle"
script/source = "extends CsmState

func _on_enter() -> void:
	parent.reset_bored_timer()
	parent.set_speed(parent.walk_speed)
	if randf() < 0.5: parent.animation_player.play(parent.idle_ani)

func _process_transition(delta: float) -> Array:
	if parent.is_player_too_close():
		return [true, \"Flee\"]
	if has_been_in_state_longer_than(parent.bored_timer):
		return [true, \"Wander\"]
	return [false, \"\"]  # [should_transition, next_state_name]

func _process_state(delta: float) -> void:
	parent.try_move_to_target(delta)
"

[sub_resource type="GDScript" id="GDScript_5a2bf"]
resource_name = "RoachWander"
script/source = "extends CsmState

func _on_enter() -> void:
	parent.pick_random_destination()
	parent.set_speed(parent.walk_speed)
	parent.animation_player.play(parent.walk_ani)

func _on_exit() -> void:
	parent.animation_player.stop()

func _process_transition(delta: float) -> Array:
	if parent.is_player_too_close():
		return [true, \"Flee\"]
	if parent.navigation_agent.is_navigation_finished():
		return [true, \"Idle\"]
	return [false, \"\"]

func _process_state(delta: float) -> void:
	parent.try_move_to_target(delta)
"

[sub_resource type="GDScript" id="GDScript_5rdty"]
resource_name = "RoachFlee"
script/source = "extends CsmState

func _on_enter() -> void:
	parent.set_speed(parent.run_speed)
	parent.navigation_agent.set_target_position(parent.escape_hole.global_position)
	parent.animation_player.speed_scale = 2.0
	parent.animation_player.play(\"RoachAnimations/RoachWalk\")

func _on_exit() -> void:
	parent.animation_player.stop()
	parent.animation_player.speed_scale = 1.0

func _process_transition(delta: float) -> Array:
	#print(parent.master.global_position.distance_squared_to(parent.escape_hole.global_position))
	#if not parent.is_player_too_close():
		#return [true, \"Idle\"]
	#if parent.navigation_agent.is_navigation_finished() and parent.is_player_too_close():
		#parent.pick_escape_destination()
		#parent.navigation_agent.set_target_position(parent.escape_hole.global_position)
	if parent.master.global_position.distance_squared_to(parent.escape_hole.global_position) < 1.0:
		return [true, \"Hide\"]
	#elif parent.navigation_agent.is_navigation_finished() and not parent.is_player_too_close():
		#return [true, \"Idle\"]
	return [false, \"\"]

func _process_state(delta: float) -> void:
	parent.try_move_to_target(delta)
"

[sub_resource type="GDScript" id="GDScript_qo5ux"]
resource_name = "RoachHide"
script/source = "extends CsmState

var time_threat_left := 0.0
var hide_time := 0.0
var is_safe := false


func _on_enter() -> void:
	parent.master.visible = false
	
	hide_time = randf_range(parent.min_hide_time, parent.max_hide_time)
	is_safe = not parent.is_player_too_close()
	if is_safe:
		mark_player_leave()

func _on_exit() -> void:
	var exit_offset : Vector3 = (parent.master.global_position - parent.escape_hole.global_position).normalized() * randf_range(1.0, 3.0)
	parent.navigation_agent.set_target_position(parent.escape_hole.global_position + exit_offset)
	parent.master.visible = true

func _process_state(delta: float) -> void:
	var player_is_close : bool = parent.is_player_too_close()
	
	# Update safety status
	if player_is_close and is_safe:
		set_is_safe(false)
	elif not player_is_close and not is_safe:
		set_is_safe(true)

func _process_transition(delta: float) -> Array:
	# Debug print
	if debug: print(\"Safe duration: \", get_safe_duration())
	
	
	if is_safe and has_been_safe_longer_than(hide_time):
		return [true, \"Idle\"]
	
	return [false, \"\"]

func set_is_safe(value: bool) -> void:
	if value == is_safe: 
		return
	
	is_safe = value
	
	if is_safe:
		mark_player_leave()
	else:
		time_threat_left = 0.0

func mark_player_leave() -> void:
	time_threat_left = Time.get_unix_time_from_system()

func get_safe_duration() -> float:
	if time_threat_left == 0.0:
		return 0.0
	return Time.get_unix_time_from_system() - time_threat_left

func has_been_safe_longer_than(time: float) -> bool:
	return get_safe_duration() >= time
"

