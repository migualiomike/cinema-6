[sub_resource type="GDScript" id="GDScript_xhic4"]
resource_name = "cutout_clown"
script/source = "extends Anomaly

@onready var level_manager: LevelManager = $\"../..\"

@export var cutout_clown: StaticBody3D
@export var navigation_agent: NavigationAgent3D
@export var movement_speed := 0.3

var og_pos: Transform3D
var is_on_screen := false


func _ready() -> void:
	og_pos = cutout_clown.global_transform
	for child in cutout_clown.get_children():
		if child is VisibleOnScreenNotifier3D:
			child.screen_entered.connect(on_screen_logic.bind(true))
			child.screen_exited.connect(on_screen_logic.bind(false))


func _physics_process(delta: float) -> void:
	if is_active and not is_on_screen:
		var dir = level_manager.player.global_position - cutout_clown.global_position
		var target_angle_y = atan2(dir.x, dir.z)
		cutout_clown.rotation.y = target_angle_y

		cutout_clown.global_position.x = lerp(cutout_clown.global_position.x, level_manager.player.global_position.x, delta * movement_speed)
		cutout_clown.global_position.z = lerp(cutout_clown.global_position.z, level_manager.player.global_position.z, delta * movement_speed)


func on_screen_logic(on_screen: bool) -> void:
	if on_screen:
		is_on_screen = true 
	elif on_screen == false:
		is_on_screen = false


func on_deactivate() -> void:
	cutout_clown.global_transform = og_pos
"

