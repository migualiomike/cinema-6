[sub_resource type="GDScript" id="GDScript_n2aqs"]
resource_name = "NumberManager"
script/source = "extends Node3D
@onready var level_manager: LevelManager = $\"../Level Manager\"

@onready var glow_num_1: Node3D = $GlowNum1
@onready var glow_num_2: Node3D = $GlowNum2
@onready var glow_num_3: Node3D = $GlowNum3
@onready var glow_num_4: Node3D = $GlowNum4

func _ready() -> void:
	set_room_numbers()
	level_manager.progress_changed.connect(set_room_numbers)

func set_room_numbers() -> void:
	glow_num_1.show_mesh_by_number((level_manager.cur_progress * 4) +1)
	glow_num_2.show_mesh_by_number((level_manager.cur_progress * 4) +2)
	glow_num_3.show_mesh_by_number((level_manager.cur_progress * 4) +3)
	glow_num_4.show_mesh_by_number((level_manager.cur_progress * 4) +4)
	pass
"

