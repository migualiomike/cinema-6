[sub_resource type="GDScript" id="GDScript_5nwvk"]
resource_name = "WinScript"
script/source = "extends Node3D
@onready var win_open_area: Area3D = $WinOpenArea

@onready var door_open_area: Area3D = $DoorOpenArea
@onready var level_manager: LevelManager = $\"../Level Manager\"
@onready var right_door: StaticBody3D = $\"../CinemaLevel1_Imported/MainHall/PackedScene_CinemaDoorL_003\"
@onready var left_door: StaticBody3D = $\"../CinemaLevel1_Imported/MainHall/PackedScene_CinemaDoorR_003\"

var tween:Tween

func _ready() -> void:
	door_open_area.body_entered.connect(win_logic)
	win_open_area.body_entered.connect(on_win_enter)

func win_logic(body:Node3D) -> void:
	if body.is_in_group(\"Player\") and level_manager.cur_progress == 6:
		tween = create_tween().set_ease(tween.EASE_OUT).set_parallel(true)
		tween.set_trans(tween.TRANS_LINEAR)
		tween.tween_property(left_door, \"rotation:y\", deg_to_rad(-95.0), 1.0).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CIRC)
		tween.tween_property(right_door, \"rotation:y\", deg_to_rad(-265.0), 1.0).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CIRC)

func on_win_enter(body:Node3D) -> void:
	if body.is_in_group(\"Player\") and level_manager.cur_progress == 6:
		body.on_win()
		print(\"sueme\")
"

