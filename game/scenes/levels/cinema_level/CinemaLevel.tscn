[sub_resource type="GDScript" id="GDScript_jx5ev"]
resource_name = "CutoutClownHide"
script/source = "extends Anomaly


@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var clown_horn: AudioStreamPlayer3D = $\"../CutoutClown/CutoutClown/ClownHorn\"

@onready var level_manager: LevelManager = $\"../..\"
@export var cutout_clown: StaticBody3D
@export var hiding_spots : Array [Marker3D]
var og_pos: Transform3D
var is_on_screen := false
var player_has_entered_room := false
var has_found_clown := false : 
	set(value):
		if value == has_found_clown: return
		if value == true: player_found_clown()
		has_found_clown = value


func _ready() -> void:
	level_manager.player_hall_changed.connect(player_enter_room)
	og_pos = cutout_clown.global_transform
	for child in cutout_clown.get_children():
		if child is VisibleOnScreenNotifier3D:
			child.screen_entered.connect(on_screen_logic.bind(true))
			child.screen_exited.connect(on_screen_logic.bind(false))

func process_anomaly(delta) -> void:
	find_clown_logic()

func player_enter_room(has_entered:bool) -> void:
	if player_has_entered_room == false and is_active: animation_player.play(\"CloseDoors\")
	player_has_entered_room = true

func player_found_clown() -> void:
	if is_active: 
		animation_player.play_backwards(\"CloseDoors\")
		clown_horn.play()

func find_clown_logic() -> void:
	#print(level_manager.player.global_position.distance_to(cutout_clown.global_position))
	var player_forward := -level_manager.player.global_transform.basis.z.normalized()
	var dir_to_target := (cutout_clown.global_position - level_manager.player.global_position).normalized()
	var dis_to_target := level_manager.player.global_position.distance_to(cutout_clown.global_position)
	var view_angle := player_forward.dot(dir_to_target)
	if level_manager.player_in_hall and view_angle > 0.7 and dis_to_target < 5:
		has_found_clown = true
	
	#print(is_in_view) # > 0.95
	#print(level_manager.player.global_position.distance_to(cutout_clown.global_position)) # < 5
	#print(view_angle)

func on_activate() -> void:
	cutout_clown.global_transform = hiding_spots.pick_random().global_transform
	#cutout_clown.global_position = Vector3(26.783, 0.07, 5.463)
	#cutout_clown.global_rotation = Vector3(0.0, deg_to_rad(170.8), 0)
	has_found_clown = false
	player_has_entered_room = false

func on_deactivate() -> void:
	cutout_clown.global_transform = og_pos
	player_has_entered_room = false
	has_found_clown = false

func on_screen_logic(on_screen: bool) -> void:
	if on_screen:
		is_on_screen = true 
	elif on_screen == false:
		is_on_screen = false
"

