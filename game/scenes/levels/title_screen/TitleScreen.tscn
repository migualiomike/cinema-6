[sub_resource type="GDScript" id="GDScript_jewl0"]
resource_name = "MenuScript"
script/source = "extends Control
@onready var button: Button = $Button
@onready var left_door: StaticBody3D = $\"../PackedScene_CinemaDoorL_007\"
@onready var right_door: StaticBody3D = $\"../PackedScene_CinemaDoorR_007\"
@onready var fade_rect: ColorRect = $FadeRect
@onready var camera: Camera3D = $\"../Camera3D\"

var tween:Tween

func _ready() -> void:
	button.pressed.connect(on_start_pressed)
	button.button_down.connect(on_button_down)
	button.button_up.connect(on_button_up)
	button.pivot_offset = button.size * Vector2(0.5, 1.0)
	
	
func on_start_pressed() -> void:
	
	pass

func on_button_down() -> void:
	if tween: tween.kill()
	button.scale = Vector2(0.9, 0.7)
	pass

func on_button_up() -> void:
	tween = create_tween().set_ease(tween.EASE_OUT).set_parallel(true)
	tween.set_trans(tween.TRANS_LINEAR)
	tween.tween_property(button, \"scale\", Vector2(1,1), 0.25)
	tween.tween_property(button, \"modulate:a\", 0.0, 0.25)
	tween.tween_property(fade_rect, \"modulate:a\", 1.0, 0.5).set_delay(4.0)
	tween.tween_property(left_door, \"rotation:y\", deg_to_rad(170.0), 0.8).set_delay(1.0).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CIRC)
	tween.tween_property(right_door, \"rotation:y\", deg_to_rad(10.0), 0.8).set_delay(1.0).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CIRC)
	tween.tween_property(camera, \"position:x\", -0.5, 0.8).set_delay(2.0).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_CIRC)
	await tween.finished
	get_tree().change_scene_to_file(\"uid://omurinejaiqf\")
	
"

