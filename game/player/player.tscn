[sub_resource type="GDScript" id="GDScript_rkbax"]
resource_name = "Fade"
script/source = "extends ColorRect

func _ready() -> void:
	var tween:Tween
	tween = create_tween().set_ease(tween.EASE_OUT)
	tween.set_trans(tween.TRANS_LINEAR)
	tween.tween_property(self, \"modulate:a\", 0.0, 1.0).set_delay(1.0)
"

